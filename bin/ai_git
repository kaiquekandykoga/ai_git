#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/ai_git"

begin
  AIGit.start(ARGV)
rescue Interrupt
  warn "\nAborted."
  exit 130
rescue StandardError => e
  # The library raises bare strings, so a failure reads as one line, not a backtrace.
  AIGit::UI.error("ai_git: #{e.message}")
  exit 1
end
